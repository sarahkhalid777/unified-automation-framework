# Unified Automation Framework configuration.
# Copy to .env and adjust. Never commit .env. In CI these come from GitHub Secrets / variables.
# Real environment variables always override values in this file.

# ---- Execution environment ------------------------------------------------
# local | ci  (defaults to "ci" when the CI variable is set, otherwise "local")
TEST_ENV=local
# Run browsers headed on a local machine (ignored in CI)
HEADED=false
# Parallel workers: a number or a CPU percentage such as 50%. Empty = Playwright default.
WORKERS=
# Retries per failed test. Defaults: local 0, ci 2.
RETRIES=
LOG_LEVEL=info

# ---- Application under test -------------------------------------------------
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
# Polled before web/API/integration runs. Set to "none" to disable.
HEALTHCHECK_URL=http://localhost:3000/api/health
# Header carrying a per-request id that the application writes to its log
CORRELATION_HEADER=x-correlation-id
# Structured application log, read for failure analysis (optional)
APP_LOG_FILE=../sample-app/logs/app.log

# ---- Timeouts (milliseconds) -----------------------------------------------
TEST_TIMEOUT_MS=60000
EXPECT_TIMEOUT_MS=10000
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
API_TIMEOUT_MS=15000

# ---- PostgreSQL (required only by database and integration tests) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shoplite
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=5

# ---- Mobile (Appium + WebdriverIO, Android) - only needed for `npm run test:mobile` ----
# Android SDK and JDK used by Appium's UiAutomator2 driver (absolute paths)
ANDROID_HOME=
# Only if your emulators are not in the default ~/.android/avd
ANDROID_AVD_HOME=
JAVA_HOME=
# Where Appium keeps its installed drivers (`npm run mobile:setup` installs UiAutomator2 there)
APPIUM_HOME=
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
# false = connect to an Appium server you started yourself instead of starting one
APPIUM_START_LOCALLY=true
# adb serial or "Android Emulator" (first connected device). ANDROID_AVD starts that emulator if none is running.
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_AVD=
ANDROID_PLATFORM_VERSION=
# App under test: Sauce Labs "My Demo App" (open source), path relative to this folder
ANDROID_APP_PATH=../.tools/apps/mda-2.3.0-27.apk
ANDROID_APP_PACKAGE=com.saucelabs.mydemoapp.android
ANDROID_APP_ACTIVITY=.view.activities.SplashActivity
MOBILE_ELEMENT_TIMEOUT_MS=15000
