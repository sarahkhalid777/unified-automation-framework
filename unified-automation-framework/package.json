{
  "name": "unified-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Unified Web, API, Database and Mobile test automation framework (Playwright + WebdriverIO/Appium + PostgreSQL).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/mobile",
    "lint": "eslint .",
    "verify": "npm run typecheck && npm run lint && npm run check:test-ids",
    "test": "playwright test",
    "test:framework": "playwright test --project=framework",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:database": "playwright test --project=database",
    "test:web": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:integration": "playwright test --project=integration",
    "test:mobile": "wdio run wdio.conf.ts",
    "test:id": "playwright test --grep",
    "report:html": "playwright show-report reports/html",
    "report:allure": "allure generate reports/allure-results reports/allure-results-mobile --config allurerc.mjs --clean",
    "report:allure:open": "allure open reports/allure-report",
    "check:test-ids": "node scripts/check-test-ids.mjs",
    "mobile:setup": "appium driver install uiautomator2@8.7.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@wdio/allure-reporter": "10.2.0",
    "@wdio/appium-service": "10.2.0",
    "@wdio/cli": "10.2.0",
    "@wdio/globals": "10.2.0",
    "@wdio/local-runner": "10.2.0",
    "@wdio/mocha-framework": "10.2.0",
    "@wdio/spec-reporter": "10.2.0",
    "@wdio/types": "10.2.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "allure": "3.33.0",
    "allure-js-commons": "3.15.0",
    "allure-playwright": "3.15.0",
    "appium": "3.9.1",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "webdriverio": "10.2.0"
  }
}
