# ShopLite sample application configuration.
# Copy to .env and adjust. Never commit the real .env file.

APP_PORT=3000

# PostgreSQL connection used by the application
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shoplite
DB_USER=shoplite
DB_PASSWORD=change-me

# Secret used to sign customer access tokens (any long random string)
JWT_SECRET=replace-with-a-long-random-string
JWT_TTL=2h

# Structured JSON application log (read by the automation framework for log analysis)
APP_LOG_FILE=logs/app.log

# When true, `npm run start:local` downloads and runs a real PostgreSQL server
# from npm (embedded-postgres) - no Docker or admin rights required.
DB_EMBEDDED=true
DB_EMBEDDED_DATA_DIR=.pgdata
