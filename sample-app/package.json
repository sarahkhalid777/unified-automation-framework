{
  "name": "shoplite-sample-app",
  "version": "1.0.0",
  "private": true,
  "description": "ShopLite - a lightweight e-commerce application (REST API + web UI + PostgreSQL) used as the system under test for the unified automation framework POC.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:local": "node scripts/start-local.js",
    "db:embedded": "node scripts/embedded-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1"
  },
  "optionalDependencies": {
    "embedded-postgres": "19.0.0-beta.20"
  }
}
